{
  "rewrites": [
    {
      "source": "/actividades/:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|Twitterbot|WhatsApp|TelegramBot|LinkedInBot|Slackbot|Discordbot|Pinterest|redditbot|Applebot|SkypeUriPreview|vkShare|Iframely|Embedly|W3C_Validator).*"
        }
      ],
      "destination": "/api/og/:id"
    },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
